<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Lawnchair" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.TransparentDialog" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#3000</item>
    </style>

    <style name="MarqueeTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>
</resources>
