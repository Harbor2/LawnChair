<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层白色圆形 -->
    <item>
        <shape android:shape="oval">
            <size android:width="14dp" android:height="14dp"/>
            <solid android:color="@color/white" />
        </shape>
    </item>

    <!-- 内层黑色圆形 -->
    <item android:top="4dp" android:bottom="4dp" android:start="4dp" android:end="4dp">
        <shape android:shape="oval">
            <size android:width="22dp" android:height="22dp"/>
            <solid android:color="@color/text_main_color" />
        </shape>
    </item>
</layer-list>